# ~/.zshrc — géré par chezmoi (ne pas éditer directement : `chezmoi edit ~/.zshrc`)
# Pour profiler le démarrage : décommenter ici et `zprof` à la fin du fichier.
# zmodload zsh/zprof

{{ if eq .chezmoi.os "darwin" -}}
# --- Homebrew ---
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}

# --- PATH ---
typeset -U path   # pas de doublons
path=("$HOME/.local/bin" $path)

# --- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                              # le prompt est géré par starship
zstyle ':omz:update' mode disabled        # mises à jour gérées par chezmoi (.chezmoiexternal.toml)
plugins=(
  git
  zsh-autosuggestions
  terraform
  nvm
  zsh-syntax-highlighting                 # doit rester en DERNIER
)

export NVM_DIR="$HOME/.nvm"
zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' lazy-cmd nest tsc eslint prettier
zstyle ':omz:plugins:nvm' autoload yes
zstyle ':omz:plugins:nvm' silent-autoload yes
source "$ZSH/oh-my-zsh.sh"
# --- nvm : charge nvm (lazy) dès qu'un .nvmrc est présent dans le dossier ou un parent ---
# Le plugin oh-my-zsh active ensuite la bonne version et gère le retour à la version par défaut.
_nvm_autoload_on_nvmrc() {
  (( $+functions[_omz_nvm_load] )) || return 0     # nvm déjà chargé (ou absent) : rien à faire
  local dir="$PWD"
  while [[ -n "$dir" && "$dir" != "/" ]]; do
    if [[ -f "$dir/.nvmrc" ]]; then
      _omz_nvm_load
      return 0
    fi
    dir="${dir:h}"
  done
}
autoload -U add-zsh-hook
add-zsh-hook chpwd _nvm_autoload_on_nvmrc
_nvm_autoload_on_nvmrc     # cas d'un terminal ouvert directement dans un projet


# --- Éditeur / pager ---
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
  alias vi='nvim'
  alias vim='nvim'
else
  export EDITOR="${EDITOR:-vim}"       # repli tant que neovim n'est pas installé
fi
export BAT_THEME="${BAT_THEME:-TwoDark}"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# --- fzf (Ctrl+T : fichiers, Alt+C : dossiers) ---
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
  export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
  export FZF_ALT_C_OPTS="--preview 'lsd --tree --depth 2 --color=always {}'"
fi

# --- atuin (Ctrl+R) : après fzf pour reprendre la main sur Ctrl+R ---
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

# --- zoxide : `z <dossier>` et `zi` (interactif) ---
# Pour remplacer carrément `cd` : zoxide init zsh --cmd cd
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# --- Alias ---
if command -v lsd >/dev/null 2>&1; then
  alias ls='lsd'
  alias ll='lsd -l'
  alias la='lsd -la'
  alias lt='lsd --tree --depth 2'
fi
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
fi
alias ..='cd ..'
alias ...='cd ../..'
alias cz='chezmoi'

# --- starship (en dernier) ---
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# --- Surcharges locales à la machine (secrets, tokens, PATH spécifique…) : non versionné ---
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
